[Unit]
Description=Dot Sim (unofficial Kode Dot in the browser)
After=network-online.target

[Service]
User=dotsim
WorkingDirectory=/opt/dot-sim/dotsim/server
Environment=KODE_PORT=8000
Environment=KODE_SIM=/opt/dot-sim/dotsim/hostsim
Environment=KODE_STATIC=/opt/dot-sim/dotsim/web
Environment=KODE_KSWEB=/opt/dot-sim/web
Environment=KODE_LOCAL_APPS=/opt/dot-sim/dotsim/apps
Environment=KODE_SDK=/opt/kode/src/kode-sdk
Environment=KODE_BUILDS=/var/lib/dotsim/builds
Environment=KODE_DATA=/var/lib/dotsim/data
Environment=KODE_WORK=/var/lib/dotsim/work
Environment=KODE_MAX_SESSIONS=4
ExecStart=/usr/bin/python3 /opt/dot-sim/dotsim/server/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
